formatter:
  type: basic
  indent: 2
  retain_line_breaks: true
  retain_line_breaks_single: true
  pad_line_comments: 2
  trim_trailing_whitespace: true
  eof_newline: true

  # this is equal to "indent", above, by default.
  # if the value of indent isn't enough indentation,
  # try adjusting this value
  # array_indent: 4
  
  # this might also be related to what we're looking for
  # indent_root_array: true
  
  force_array_style: block